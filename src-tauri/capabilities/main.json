{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Permite que o webview local da janela principal consulte e administre raízes autorizadas.",
  "windows": ["main"],
  "permissions": [
    "allow-get-workspace-view",
    "allow-select-root",
    "allow-remove-root",
    "allow-get-repo-status",
    "allow-get-file-diff",
    "allow-get-git-capabilities"
  ]
}
